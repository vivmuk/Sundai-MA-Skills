# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Generated deliverables — the whole point is that these are produced fresh.
# If you want to keep one, move it out of the repo.
output/
out/
*.pptx
*.docx
*.pdf
!shared/templates/**/*.docx
!shared/templates/**/*.pptx

# Local API keys. Never commit these.
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Workshop participant work — teams generate a lot of this and none of it
# belongs in the upstream repository.
workshop/participant-output/

# Local runs and model weights
outputs/
*.wav
*.mp3
*.pt

# Evolution Engine run output. Regenerate with:
#   python3 scripts/evolve.py probe kol-engagement-brief --adapter mock --yes
#   python3 scripts/evolve.py run   kol-engagement-brief --adapter mock --yes
# Mock results are not findings. Committing them would put numbers in the
# repository that look like evidence about skill quality and are not.
evolution/experiments/*/
evolution/lineages/*/lineage.jsonl
evolution/lineages/*/neutral-band.json
